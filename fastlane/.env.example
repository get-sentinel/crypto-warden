# Copy to fastlane/.env and fill in. Both are read by the `beta` lane.
# fastlane/.env is gitignored — never commit real values.

# App Store Connect API key. The .p8 itself lives in
# ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
ASC_KEY_ID=

# Found in App Store Connect → Users and Access → Integrations → Team Keys,
# shown once above the key list. A UUID.
ASC_ISSUER_ID=
